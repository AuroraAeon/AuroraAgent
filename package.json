{
  "name": "auroraagent",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "AuroraAgent：本地 Agent 运行时（终端 + 网页，零依赖后端，可打包为独立 macOS Application）；模型速测能力作为底座保留",
  "scripts": {
    "start": "node web.mjs",
    "web": "node web.mjs",
    "chat": "node chat.mjs",
    "check": "node check.mjs",
    "test": "node test/run-tests.mjs",
    "color": "node tools/color-test.mjs",
    "service": "node tools/install-service.mjs",
    "service:status": "node tools/install-service.mjs --status",
    "service:remove": "node tools/install-service.mjs --remove",
    "app:build": "npm run build:web && node tools/build-app.mjs",
    "publish": "npm run build:web && node tools/build-app.mjs && launchctl kickstart -k gui/$(id -u)/com.modeltester.app",
    "dev:web": "npm --prefix web-ui run dev",
    "build:web": "npm --prefix web-ui run build"
  }
}
